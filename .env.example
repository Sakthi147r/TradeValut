# =============================================================================
# TradeVault Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# =============================================================================

# Server Port (default: 3000)
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# -----------------------------------------------------------------------------
# Shopify Storefront API
# Required for live catalog fetching and cart operations.
# -----------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_ACCESS_TOKEN=your-storefront-access-token

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Supabase)
# Required for user sessions, saved favorites, quotes, and newsletter signups.
# Example: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Authentication & Session Security
# -----------------------------------------------------------------------------
JWT_SECRET=your-random-jwt-secret-at-least-32-chars
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=
